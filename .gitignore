# Python
__pycache__/
*.pyc
*.pyo
.env

# Model weights (large binary — retrain via scripts/train_combined.py)
*.pt
*.onnx

# MediaPipe task file (large binary — download separately)
*.task

# Dataset directories (large — re-download via scripts/download_models.py)
models/raw_datasets/
models/combined_dataset/
models/roboflow_download/
training_frames/

# Training output (large — regenerated on each training run)
models/training/

# Logs and caches
logs/
.pytest_cache/

# Debug artifacts (generated images/videos only, not exploration scripts)
output/debug/
output/*.jpg
output/*.mp4

# Videos (keep all source and generated video files out of Git)
videos/
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wmv
*.flv
*.m4v
*.mpg
*.mpeg
*.3gp
*.mts
*.m2ts
*.ts
*.vob
*.ogv

# IDE
.vscode/
.idea/
